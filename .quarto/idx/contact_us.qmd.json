{"title":"Contact and Feedback","markdown":{"yaml":{"title":"Contact and Feedback","anchor-sections":false,"format":{"html":{"toc":false}},"page-layout":"full"},"headingText":"Contact Us","containsRefs":false,"markdown":"\n\n::: {style=\"display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem;\"}\n\n<!-- Contact Card -->\n::: {.contact-card style=\"background-color: #f8f9fa; padding: 2rem; border-radius: 1rem; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);\"}\n\n\n::: {style=\"display: flex; flex-wrap: wrap; gap: 2rem;\"}\n\n::: {style=\"flex: 1 1 250px;\"}\n<span style=\"font-weight: 700; font-size: 1.2rem;\">Cara Wilson</span>  \n<span style=\"color: #0077be;\">Manager, CoastWatch West Coast</span><br>\n99 Pacific Street, Suite 255A\nMonterey, CA 93940\n[cara.wilson@noaa.gov](mailto:cara.wilson@noaa.gov)  \n831-648-5337\n:::\n\n::: {style=\"flex: 1 1 250px;\"}\n<span style=\"font-weight: 700; font-size: 1.2rem;\">Dale Robinson</span>  \n<span style=\"color: #0077be;\">Development Lead, CoastWatch West Coast</span><br>\n110 Shaffer Road\nSanta Cruz, CA 95060\n[dale.robinson@noaa.gov](mailto:dale.robinson@noaa.gov)  \n831-420-3667\n:::\n\n:::\n:::\n\n<!-- Feedback Card -->\n::: {.form-card style=\"background-color: #f8f9fa; padding: 2rem; border-radius: 1rem; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);\"}\n\n### Guest Book and Feedback Form\nPlease comment on the website and data products.\n\n::: {style=\"display: flex; flex-wrap: wrap; gap: 2rem;\"}\n\n::: {style=\"flex: 1 1 250px;\"}\n<input type=\"text\" placeholder=\"Name (required)\" required>\n<input type=\"email\" placeholder=\"Email (required)\" required>\n:::\n\n::: {style=\"flex: 1 1 250px;\"}\n<input type=\"text\" placeholder=\"Organization (required)\" required>\n<input type=\"tel\" placeholder=\"Phone\">\n:::\n\n::: {style=\"flex: 1 1 250px;\"}\n<input type=\"text\" placeholder=\"Address\">\n<input type=\"text\" placeholder=\"City-State-Zip-Country\">\n:::\n\n<!-- Dropdown -->\n<select required style=\"padding: 0.75rem; border-radius: 6px; border: 1px solid #ccc; font-size: 0.95rem; width: 100%;\">\n  <option value=\"\" disabled selected>***CATEGORY***</option>\n  <option>NOAA (intra-agency)</option>\n  <option>US Government (non-NOAA)</option>\n  <option>State Government</option>\n  <option>Local Government</option>\n  <option>Foreign Government</option>\n  <option>Academic (US)</option>\n  <option>Academic (Foreign)</option>\n  <option>Private</option>\n  <option>Military</option>\n  <option>Other</option>\n</select>\n\n<textarea rows=\"6\" placeholder=\"Please enter comments here...\" style=\"padding: 0.75rem; border-radius: 6px; border: 1px solid #ccc;\"></textarea>\n\n<!-- Submit and Clear Buttons -->\n<button type=\"submit\" class=\"btn btn-primary\">Submit Comments</button>\n<button type=\"reset\" class=\"btn btn-primary\">Clear Form</button>\n:::\n\n:::\n:::","srcMarkdownNoYaml":"\n\n::: {style=\"display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem;\"}\n\n<!-- Contact Card -->\n::: {.contact-card style=\"background-color: #f8f9fa; padding: 2rem; border-radius: 1rem; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);\"}\n\n### Contact Us\n\n::: {style=\"display: flex; flex-wrap: wrap; gap: 2rem;\"}\n\n::: {style=\"flex: 1 1 250px;\"}\n<span style=\"font-weight: 700; font-size: 1.2rem;\">Cara Wilson</span>  \n<span style=\"color: #0077be;\">Manager, CoastWatch West Coast</span><br>\n99 Pacific Street, Suite 255A\nMonterey, CA 93940\n[cara.wilson@noaa.gov](mailto:cara.wilson@noaa.gov)  \n831-648-5337\n:::\n\n::: {style=\"flex: 1 1 250px;\"}\n<span style=\"font-weight: 700; font-size: 1.2rem;\">Dale Robinson</span>  \n<span style=\"color: #0077be;\">Development Lead, CoastWatch West Coast</span><br>\n110 Shaffer Road\nSanta Cruz, CA 95060\n[dale.robinson@noaa.gov](mailto:dale.robinson@noaa.gov)  \n831-420-3667\n:::\n\n:::\n:::\n\n<!-- Feedback Card -->\n::: {.form-card style=\"background-color: #f8f9fa; padding: 2rem; border-radius: 1rem; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);\"}\n\n### Guest Book and Feedback Form\nPlease comment on the website and data products.\n\n::: {style=\"display: flex; flex-wrap: wrap; gap: 2rem;\"}\n\n::: {style=\"flex: 1 1 250px;\"}\n<input type=\"text\" placeholder=\"Name (required)\" required>\n<input type=\"email\" placeholder=\"Email (required)\" required>\n:::\n\n::: {style=\"flex: 1 1 250px;\"}\n<input type=\"text\" placeholder=\"Organization (required)\" required>\n<input type=\"tel\" placeholder=\"Phone\">\n:::\n\n::: {style=\"flex: 1 1 250px;\"}\n<input type=\"text\" placeholder=\"Address\">\n<input type=\"text\" placeholder=\"City-State-Zip-Country\">\n:::\n\n<!-- Dropdown -->\n<select required style=\"padding: 0.75rem; border-radius: 6px; border: 1px solid #ccc; font-size: 0.95rem; width: 100%;\">\n  <option value=\"\" disabled selected>***CATEGORY***</option>\n  <option>NOAA (intra-agency)</option>\n  <option>US Government (non-NOAA)</option>\n  <option>State Government</option>\n  <option>Local Government</option>\n  <option>Foreign Government</option>\n  <option>Academic (US)</option>\n  <option>Academic (Foreign)</option>\n  <option>Private</option>\n  <option>Military</option>\n  <option>Other</option>\n</select>\n\n<textarea rows=\"6\" placeholder=\"Please enter comments here...\" style=\"padding: 0.75rem; border-radius: 6px; border: 1px solid #ccc;\"></textarea>\n\n<!-- Submit and Clear Buttons -->\n<button type=\"submit\" class=\"btn btn-primary\">Submit Comments</button>\n<button type=\"reset\" class=\"btn btn-primary\">Clear Form</button>\n:::\n\n:::\n:::"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":false,"output":true,"warning":false,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":f